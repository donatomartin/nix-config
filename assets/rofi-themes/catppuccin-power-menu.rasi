* {
    font: "JetBrainsMono Nerd Font 12";
    text-color: #d7d3e7;
    background-color: transparent;
    spacing: 0;

    bg: rgba(31, 30, 48, 0.98);
    bg-soft: rgba(45, 44, 68, 0.96);
    bg-softer: rgba(51, 50, 76, 0.92);
    border-soft: rgba(159, 152, 190, 0.24);
    accent: #b996e8;
    accent-text: #2a2638;
    muted: #aaa4bd;
}

window {
    width: 1052px;
    height: 566px;
    location: center;
    border: 2px;
    border-color: @border-soft;
    border-radius: 16px;
    background-color: @bg;
    padding: 14px;
}

mainbox {
    orientation: horizontal;
    spacing: 14px;
    children: [ "left-pane", "right-pane" ];
}

left-pane {
    width: 512px;
    spacing: 10px;
    orientation: vertical;
    children: [ "inputbar", "mode-switcher", "textbox-system-info" ];
}

right-pane {
    width: 480px;
    spacing: 0px;
    orientation: vertical;
    children: [ "listview" ];
    padding: 0px;
}

inputbar {
    children: [ "icon-search", "prompt", "entry" ];
    spacing: 9px;
    padding: 11px 16px;
    background-color: @bg-softer;
    border-radius: 8px;
}

icon-search {
    filename: "search";
    size: 22px;
    text-color: @muted;
    vertical-align: 0.5;
}

prompt {
    text-color: #d1cae2;
    vertical-align: 0.5;
    font: "JetBrainsMono Nerd Font 12";
}

entry {
    vertical-align: 0.5;
    placeholder: "Search";
    placeholder-color: @muted;
    text-color: #e5e0f2;
}

textbox-system-info {
    vertical-align: 0.0;
    horizontal-align: 0.0;
    expand: true;
    padding: 20px 22px;
    margin: 0px;
    border-radius: 8px;
    border: 1px;
    border-color: @border-soft;
    background-color: rgba(35, 34, 53, 0.45);
    text-color: #dcd7ea;
    font: "JetBrainsMono Nerd Font 12";
    markup: true;
    str: "System Monitor\n\nBattery: unavailable\nVolume: unavailable\nDate: unavailable";
}

mode-switcher {
    spacing: 7px;
}

button shell {
    str: ">_";
}

button {
    font: "JetBrainsMono Nerd Font 17";
    border-radius: 7px;
    padding: 8px 0px;
    width: 166px;
    horizontal-align: 0.5;
    background-color: rgba(47, 46, 70, 0.95);
    text-color: #d3cde2;
}

button selected {
    background-color: @accent;
    text-color: @accent-text;
}

listview {
    lines: 7;
    columns: 1;
    dynamic: false;
    fixed-height: true;
    spacing: 9px;
    padding: 0px;
    cycle: false;
    scrollbar: false;
}

element {
    orientation: horizontal;
    border-radius: 7px;
    padding: 9px 18px;
    spacing: 16px;
    background-color: @bg-soft;
}

element selected {
    background-color: @accent;
    text-color: #f4edf9;
}

element-icon {
    size: 2.0em;
    vertical-align: 0.5;
}

element-text {
    horizontal-align: 0.0;
    vertical-align: 0.5;
    text-color: inherit;
}
